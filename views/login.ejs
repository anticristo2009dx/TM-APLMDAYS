<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>ingreso seguro</title>

  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet" />

  <link rel="stylesheet" href="/shared1.css" />
  <link rel="stylesheet" href="/login.css" />
  <link rel="stylesheet" href="/theme.css" />
</head>

<body class="login-page">

  <div class="login-bg-icons" aria-hidden="true">
    <span class="material-symbols-outlined">qr_code_2</span>
    <span class="material-symbols-outlined">security</span>
    <span class="material-symbols-outlined">verified_user</span>
    <span class="material-symbols-outlined">lock</span>
    <span class="material-symbols-outlined">shield</span>
    <span class="material-symbols-outlined">qr_code_2</span>
    <span class="material-symbols-outlined">badge</span>
    <span class="material-symbols-outlined">security</span>
    <span class="material-symbols-outlined">lock</span>
    <span class="material-symbols-outlined">verified_user</span>
    <span class="material-symbols-outlined">shield</span>
    <span class="material-symbols-outlined">qr_code_2</span>
    <span class="material-symbols-outlined">fingerprint</span>
    <span class="material-symbols-outlined">security</span>
    <span class="material-symbols-outlined">lock</span>
    <span class="material-symbols-outlined">badge</span>
    <span class="material-symbols-outlined">qr_code_2</span>
    <span class="material-symbols-outlined">verified_user</span>
    <span class="material-symbols-outlined">shield</span>
    <span class="material-symbols-outlined">fingerprint</span>
    <span class="material-symbols-outlined">security</span>
    <span class="material-symbols-outlined">qr_code_2</span>
    <span class="material-symbols-outlined">lock</span>
    <span class="material-symbols-outlined">verified_user</span>
    <span class="material-symbols-outlined">shield</span>
    <span class="material-symbols-outlined">badge</span>
    <span class="material-symbols-outlined">qr_code_2</span>
    <span class="material-symbols-outlined">fingerprint</span>
    <span class="material-symbols-outlined">security</span>
    <span class="material-symbols-outlined">lock</span>
    <span class="material-symbols-outlined">shield</span>
    <span class="material-symbols-outlined">verified_user</span>
    <span class="material-symbols-outlined">qr_code_2</span>
    <span class="material-symbols-outlined">badge</span>
    <span class="material-symbols-outlined">security</span>
    <span class="material-symbols-outlined">fingerprint</span>
    <span class="material-symbols-outlined">lock</span>
    <span class="material-symbols-outlined">shield</span>
    <span class="material-symbols-outlined">qr_code_2</span>
    <span class="material-symbols-outlined">verified_user</span>
    <span class="material-symbols-outlined">security</span>
  </div>

  <main class="login-container">

    <header class="login-brand">
      <div class="login-brand-icon">
        <span class="material-symbols-outlined">shield_person</span>
      </div>
      <h1>INGRESO SEGURO</h1>
      <p>Acceso al Centro de Control Administrativo</p>
    </header>

    <section class="login-card">
      <form class="login-form" action="/auth" method="POST" novalidate>

        <div class="login-fields">

          <div class="field">
            <label for="email">Correo del usuario </label>
            <div class="input-icon-wrap">
              <span class="material-symbols-outlined input-icon">mail</span>
              <input id="email" name="email" type="text" placeholder="usuario" required/>
            </div>
          </div>

          <div class="field">
            <div class="field-label-row">
              <label for="password">Contraseña</label>
              <a href="#">¿Olvidaste tu contraseña?</a>
            </div>
            <div class="input-icon-wrap">
              <span class="material-symbols-outlined input-icon">lock</span>
              <input id="password" name="password" type="password" placeholder="••••••••" required />
              <button class="input-action" id="toggle-password" type="button" aria-label="Mostrar u ocultar contraseña">
                <span class="material-symbols-outlined">visibility</span>
              </button>
            </div>
          </div>



        </div>

        <button class="login-submit" type="submit">
          <span class="material-symbols-outlined">login</span>
          Iniciar Sesión
        </button>

        <div class="security-notice">
          <span class="material-symbols-outlined">verified_user</span>
          <p>Tu acceso está protegido. Nunca compartas tu contraseña con nadie, ni siquiera con el equipo de soporte.
          </p>
        </div>

      </form>
    </section>

    <footer class="login-footer">
      <div class="login-footer-links">
        <a href="#">Privacidad</a>
        <a href="#">Términos</a>
        <a href="#">Ayuda</a>
      </div>
    </footer>

  </main>

  <script src="theme-toggle.js" defer></script>
  <script src="login.js" defer></script>
  <script src="/sweetalert2.all.min.js"></script>

<% if (typeof alert !=="undefined" && alert) { %>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    Swal.fire({
      title: '<%= alertTitle %>',
      text: '<%= alertMessage %>',
      icon: '<%= alertIcon %>',
      showConfirmButton: <%= showConfirmButton? true: false %>,
      timer: <%= timer? timer: 'null' %>,
      confirmButtonText: 'Continuar',
      customClass: {
        popup: 'is-swal-brand',
        confirmButton: 'is-swal-brand__btn'
      }
    }).then(() => {
      let destino = '<%= ruta %>';
      if (!destino.startsWith('/')) {
        destino = '/' + destino;
      }
      window.location.href = destino;
    });
  </script>
  <% } %>
</body>

</html>