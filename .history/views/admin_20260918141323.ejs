            <span class="kpi-card__badge kpi-card__badge--neutral">Urgente</span>
          </div>
          <div>
            <p class="kpi-card__label">ALERTAS PENDIENTES</p>
            <p class="kpi-card__value">24</p>
          </div>
          <div class="kpi-card__bar">
            <div class="kpi-card__bar-fill kpi-card__bar-fill--error" style="width:40%"></div>
