    <!-- ================================================================
         MODAL: Agregar Estudiante
         ================================================================= -->
    <div class="modal-overlay" id="add-student-overlay" hidden>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="add-student-title">
        <div class="modal-card__header">
          <h3 class="modal-card__title" id="add-student-title">Agregar Estudiante</h3>
          <button class="modal-card__close" id="add-student-close" type="button" aria-label="Cerrar">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>

        <form class="modal-card__body" id="add-student-form" novalidate>

          <div class="field">
            <label for="student-nombre">Nombre completo</label>
            <input id="student-nombre" name="nombre" type="text" required autocomplete="off" />
            <p class="field-error" id="student-nombre-error" hidden></p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="student-grado">Grado</label>
              <select id="student-grado" name="grado" required>
                <option value="" disabled selected>Selecciona un grado</option>
                <option value="6">Sexto (6°)</option>
                <option value="7">Séptimo (7°)</option>
                <option value="8">Octavo (8°)</option>
                <option value="9">Noveno (9°)</option>
                <option value="10">Décimo (10°)</option>
                <option value="11">Once (11°)</option>
              </select>
              <p class="field-error" id="student-grado-error" hidden></p>
            </div>
            <div class="field">
              <label for="student-grupo">Grupo</label>
              <select id="student-grupo" name="grupo" required disabled>
                <option value="" disabled selected>Elige un grado primero</option>
              </select>
              <p class="field-error" id="student-grupo-error" hidden></p>
            </div>
          </div>

          <div class="field">
            <label for="student-foto">Foto (opcional)</label>
            <div class="photo-upload-row">
              <div class="photo-preview" id="student-photo-preview">
                <span class="material-symbols-outlined">person</span>
              </div>
              <button class="btn btn--outline file-upload-btn" type="button">
                <span class="material-symbols-outlined btn__icon">upload</span>
                Subir foto
                <input type="file" id="student-foto" accept="image/*" />
              </button>
            </div>
          </div>

          <div class="modal-card__preview" id="qr-preview-row" hidden>
            <span class="material-symbols-outlined">qr_code_2</span>
            <div>
              <p class="modal-card__preview-label">Matrícula y código QR (se generan automáticamente)</p>
              <p class="modal-card__preview-value" id="qr-preview-value">—</p>
            </div>
          </div>

          <p class="form-banner" id="add-student-banner" hidden></p>

          <div class="modal-card__actions">
            <button class="btn btn--outline" type="button" id="add-student-cancel">Cancelar</button>
            <button class="btn btn--primary" type="submit" id="add-student-submit">
              <span class="material-symbols-outlined btn__icon">person_add</span>
              Guardar Estudiante
            </button>
          </div>

        </form>
      </div>
    </div>

    <!-- ================================================================
         MODAL: Agregar Nuevo Usuario (Profesor / Celador)
         ================================================================= -->
    <div class="modal-overlay" id="add-user-overlay" hidden>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="add-user-title">
        <div class="modal-card__header">
          <h3 class="modal-card__title" id="add-user-title">Agregar Nuevo Usuario</h3>
          <button class="modal-card__close" id="add-user-close" type="button" aria-label="Cerrar">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>

        <form class="modal-card__body" id="add-user-form" novalidate>

          <div class="field">
            <label for="user-nombre">Nombre completo</label>
            <input id="user-nombre" name="nombre" type="text" required autocomplete="off" />
            <p class="field-error" id="user-nombre-error" hidden></p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="user-cedula">Cédula</label>
              <input id="user-cedula" name="cedula" type="text" required autocomplete="off" />
              <p class="field-error" id="user-cedula-error" hidden></p>
            </div>
            <div class="field">
              <label for="user-rol">Rol</label>
              <select id="user-rol" name="rol" required>
                <option value="" disabled selected>Selecciona un rol</option>
                <option value="1">Profesor</option>
                <option value="2">Celador</option>
              </select>
              <p class="field-error" id="user-rol-error" hidden></p>
            </div>
          </div>

          <div class="field">
            <label for="user-correo">Correo electrónico (opcional)</label>
            <input id="user-correo" name="correo" type="email" autocomplete="off" />
          </div>

          <div class="field">
            <label for="user-contrasena">Contraseña</label>
            <input id="user-contrasena" name="contrasena" type="password" required autocomplete="new-password" maxlength="20" />
            <p class="field-error" id="user-contrasena-error" hidden></p>
          </div>

          <p class="form-banner" id="add-user-banner" hidden></p>

          <div class="modal-card__actions">
            <button class="btn btn--outline" type="button" id="add-user-cancel">Cancelar</button>
            <button class="btn btn--primary" type="submit" id="add-user-submit">
              <span class="material-symbols-outlined btn__icon">group_add</span>
              Guardar Usuario
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>

