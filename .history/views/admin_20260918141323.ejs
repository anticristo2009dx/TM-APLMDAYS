    <!-- Modal: Editar Estudiante -->
    <div class="modal-overlay" id="edit-student-overlay" hidden>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-student-title">
        <div class="modal-card__header">
          <h3 class="modal-card__title" id="edit-student-title">Editar Estudiante</h3>
          <button class="modal-card__close" id="edit-student-close" type="button" aria-label="Cerrar">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <form class="modal-card__body" id="edit-student-form" novalidate>
          <input type="hidden" id="edit-student-matricula" />

          <div class="field">
            <label for="edit-student-nombre">Nombre completo</label>
            <input id="edit-student-nombre" type="text" required autocomplete="off" />
            <p class="field-error" id="edit-nombre-error" hidden></p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="edit-student-grado">Grado</label>
              <select id="edit-student-grado" required>
                <option value="6">Sexto (6°)</option>
                <option value="7">Séptimo (7°)</option>
                <option value="8">Octavo (8°)</option>
                <option value="9">Noveno (9°)</option>
                <option value="10">Décimo (10°)</option>
                <option value="11">Once (11°)</option>
              </select>
            </div>
            <div class="field">
              <label for="edit-student-grupo">Grupo</label>
              <select id="edit-student-grupo" required>
                <option value="1">Grupo 1</option>
                <option value="2">Grupo 2</option>
                <option value="3">Grupo 3</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="edit-student-estado">Estado</label>
            <select id="edit-student-estado">
              <option value="Activo">Activo</option>
              <option value="En Prueba">En Prueba</option>
              <option value="Suspendido">Suspendido</option>
            </select>
          </div>

          <p class="form-banner" id="edit-student-banner" hidden></p>

          <div class="modal-card__actions">
            <button class="btn btn--outline" type="button" id="edit-student-cancel">Cancelar</button>
            <button class="btn btn--primary" type="submit">
              <span class="material-symbols-outlined btn__icon">save</span>
              Guardar Cambios
            </button>
          </div>
        </form>
      </div>
