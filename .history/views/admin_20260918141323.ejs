                  <th>ID</th>
                  <th>Administrador</th>
                  <th>Descripción de la Acción</th>
                  <th class="text-right">Marca de Tiempo</th>
                </tr>
              </thead>
              <tbody>
<% results.forEach((usuarios)=> { %>
  <tr>
    <td>
      <%= usuarios.id_usuario %>
    </td>
    <td>
      <%= usuarios.nombre %>
    </td>
    <td class="cell--muted">
      <%= usuarios.rol %>
    </td>
    <td class="cell--muted text-right">
      <%= usuarios.cedula %>
    </td>
    <td>
      <a href="/edit/<%= usuarios.id_usuario %>" class="btn btn--secondary">Editar</a>
      <a href="/delete/<%= usuarios.id_usuario %>" class="btn btn--danger">Eliminar</a>
    </td>
  </tr>
  <% }) %>
