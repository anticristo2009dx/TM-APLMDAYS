<!DOCTYPE html>
<html lang="es" data-view="dashboard">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel de control</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />

  <!-- Igual que en views/admin.ejs: cada vista conserva las hojas de estilo
       que tenía su .html. Aquí no existe la vista "admin", así que no se
       carga admin.css. -->
  <link rel="stylesheet" href="/shared.css"    data-view-css="dashboard students" />
  <link rel="stylesheet" href="/shared1.css"   data-view-css="settings" />
  <link rel="stylesheet" href="/dashboard.css" data-view-css="dashboard" />
  <link rel="stylesheet" href="/students.css"  data-view-css="students" />
  <link rel="stylesheet" href="/settings.css"  data-view-css="settings" />
  <link rel="stylesheet" href="/theme.css" />

  <style>
    /* Solo se muestra la vista activa. display:contents hace que el <main>
       siga siendo hijo directo de <body>, para que el layout no cambie. */
    .spa-view { display: none; }
    html[data-view="dashboard"] #view-dashboard,
    html[data-view="students"]  #view-students,
    html[data-view="settings"]  #view-settings { display: contents; }
  </style>

  <script>
    /* Router mínimo, igual que en el panel de Administrador pero sin la
       vista "admin" (los usuarios Profesor/Celador no tienen acceso a ella). */
    (function () {
      var TITULOS = {
        dashboard: "Panel de control",
        students: "Estudiantes",
        settings: "Configuración"
      };

      function vistaDeLaUrl() {
        var h = window.location.hash.replace("#", "");
        return TITULOS[h] ? h : "dashboard";
      }

      window.mostrarVista = function (vista) {
        if (!TITULOS[vista]) vista = "dashboard";

        document.documentElement.setAttribute("data-view", vista);
        document.title = TITULOS[vista];

        var links = document.querySelectorAll("link[data-view-css]");
        for (var i = 0; i < links.length; i++) {
          var para = links[i].getAttribute("data-view-css").split(" ");
          links[i].disabled = para.indexOf(vista) === -1;
        }

        var nav = document.querySelectorAll("[data-view-link]");
        for (var j = 0; j < nav.length; j++) {
          var activo = nav[j].getAttribute("data-view-link") === vista;
          nav[j].classList.toggle("topnav__link--active", activo);
        }

        window.scrollTo(0, 0);
      };

      window.mostrarVista(vistaDeLaUrl());

      window.addEventListener("hashchange", function () {
        window.mostrarVista(vistaDeLaUrl());
      });

      document.addEventListener("DOMContentLoaded", function () {
        window.mostrarVista(vistaDeLaUrl());
      });
    })();
  </script>
</head>

<body>


  <nav class="topnav">
    <div class="topnav__left">
      <span class="topnav__logo">INGRESO SEGURO</span>
      <div class="topnav__links">

        <a class="topnav__link topnav__link--active" href="#dashboard" data-view-link="dashboard">Panel de control</a>
        <a class="topnav__link" href="#students" data-view-link="students">Estudiantes</a>
        <a class="topnav__link" href="#settings" data-view-link="settings">Configuración</a>
        <a class="topnav__link" href="/login">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <div class="spa-view" id="view-dashboard">
    <main class="main-content">

      <header class="page-header">
        <div>
          <p class="page-header__eyebrow">Inteligencia Institucional</p>
          <h1 class="page-header__title">Panel de Control General</h1>
        </div>
        <div class="page-header__actions">
          <button class="btn btn--outline" id="export-report-btn" type="button">
            <span class="material-symbols-outlined btn__icon">download</span>
            EXPORTAR REPORTE
          </button>
          <a class="btn btn--primary" href="qr.html">
            <span class="material-symbols-outlined btn__icon">qr_code_scanner</span>
            NUEVO INGRESO
          </a>
        </div>
      </header>

      <!-- KPI GRID -->
      <div class="kpi-grid">

        <div class="kpi-card kpi-card--primary">
          <div class="kpi-card__top">
            <div class="kpi-card__icon kpi-card__icon--primary"><span class="material-symbols-outlined">school</span>
            </div>
            <span class="kpi-card__badge kpi-card__badge--positive">+12.5%</span>
          </div>
          <div>
            <p class="kpi-card__label">TOTAL DE ESTUDIANTES</p>
            <p class="kpi-card__value">12,482</p>
          </div>
          <div class="kpi-card__bar">
            <div class="kpi-card__bar-fill kpi-card__bar-fill--primary" style="width:75%"></div>
          </div>
        </div>

        <div class="kpi-card kpi-card--secondary">
          <div class="kpi-card__top">
            <div class="kpi-card__icon kpi-card__icon--secondary"><span
                class="material-symbols-outlined">person_celebrate</span></div>
            <span class="kpi-card__badge kpi-card__badge--neutral">Estable</span>
          </div>
          <div>
            <p class="kpi-card__label">PROFESORES ACTIVOS</p>
            <p class="kpi-card__value">312</p>
          </div>
          <div class="kpi-card__bar">
            <div class="kpi-card__bar-fill kpi-card__bar-fill--secondary" style="width:92%"></div>
          </div>
        </div>

        <div class="kpi-card kpi-card--tertiary">
          <div class="kpi-card__top">
            <div class="kpi-card__icon kpi-card__icon--tertiary"><span
                class="material-symbols-outlined">event_available</span></div>
            <span class="kpi-card__badge kpi-card__badge--negative">-2.1%</span>
          </div>
          <div>
            <p class="kpi-card__label">ASISTENCIA PROMEDIO</p>
            <p class="kpi-card__value">94.2%</p>
          </div>
          <div class="kpi-card__bar">
            <div class="kpi-card__bar-fill kpi-card__bar-fill--tertiary" style="width:94%"></div>
          </div>
        </div>

        <div class="kpi-card kpi-card--error">
          <div class="kpi-card__top">
            <div class="kpi-card__icon kpi-card__icon--error"><span class="material-symbols-outlined">warning</span></div>
            <span class="kpi-card__badge kpi-card__badge--neutral">Urgente</span>
          </div>
          <div>
            <p class="kpi-card__label">ALERTAS PENDIENTES</p>
            <p class="kpi-card__value">24</p>
          </div>
          <div class="kpi-card__bar">
            <div class="kpi-card__bar-fill kpi-card__bar-fill--error" style="width:40%"></div>
          </div>
        </div>

      </div>

      <!-- DASHBOARD GRID -->
      <div class="dashboard-grid">
        <div class="glass-card panel--table">
          <div class="panel__header">
            <div>
              <h3 class="panel__title">Registros de Ingreso Recientes</h3>
              <p class="panel__subtitle">Últimos registros capturados por el lector QR en portería.</p>
            </div>
            <button class="panel__link-btn" id="export-report-btn-2" type="button">
              <span class="material-symbols-outlined" style="font-size:1rem;">download</span>
              Exportar
            </button>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Estudiante</th>
                  <th>Matrícula</th>
                  <th>Fecha y Hora</th>
                  <th>Registrado por</th>
                </tr>
              </thead>
              <tbody id="registros-tbody">
                <tr>
                  <td colspan="4" class="table-empty-state">Cargando registros…</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>

    <!-- ================================================================
         PIE DE PÁGINA
         ================================================================= -->
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand-col">
          <div class="site-footer__name">Ingreso Seguro</div>
          <p class="site-footer__desc">Plataforma integral de gestión educativa: seguridad, asistencia y administración
            institucional en un solo lugar.</p>
          <div class="site-footer__logos">
            <a class="site-footer__logo-slot" href="https://www.seduca.gov.co/" target="_blank" rel="noopener noreferrer"
              aria-label="Logo institución 1 — ir al sitio de la institución"><img
                src="logo-institucion-1.jpeg" alt="Logo institución 1" /></a>
            <a class="site-footer__logo-slot" href="https://pascualbravo.edu.co/" target="_blank"
              rel="noopener noreferrer" aria-label="Logo institución 2 — ir al sitio de la institución"><img
                src="logo-institucion-2.jpeg" alt="Logo institución 2" /></a>
            <a class="site-footer__logo-slot" href="https://www.iesanantoniodeprado.edu.co/" target="_blank"
              rel="noopener noreferrer" aria-label="Logo institución 3 — ir al sitio de la institución"><img
                src="escudo-sadep.png" alt="Logo institución 3" /></a>
          </div>
        </div>
        <div class="site-footer__cols">
          <div>
            <p class="site-footer__col-title">Nosotros</p>
            <div class="site-footer__col-links">
              <a href="nosotros.html">Quiénes somos</a>
              <a href="nosotros.html">Nuestro equipo</a>
            </div>
          </div>
          <div>
            <p class="site-footer__col-title">Ayuda</p>
            <div class="site-footer__col-links">
              <a href="#">Centro de soporte</a>
              <a href="#">Preguntas frecuentes</a>
              <a href="#">Reportar un problema</a>
            </div>
          </div>
        </div>
        </div>
        <div class="site-footer__bottom">
          <div class="site-footer__copy">© 2026 Ingreso Seguro</div>
        </div>
    </footer>
  </div>

  <div class="spa-view" id="view-students">
    <main class="main-content">


      <div class="page-header">
        <div>
          <h1 class="page-title">Estudiantes</h1>
          <p class="page-subtitle">Gestion del ingreso seguro de los estudiantes.</p>
        </div>
        <div class="header-actions">
          <button class="btn btn--outline" id="toggle-filters-btn" type="button" aria-expanded="false" aria-controls="filters-panel">
            <span class="material-symbols-outlined btn__icon">filter_list</span>
            Filtros
          </button>
          <a class="btn btn--outline" href="qr.html">
            <span class="material-symbols-outlined btn__icon">qr_code_scanner</span>
            Escanear QR
          </a>
        </div>
      </div>

      <div class="glass-card filters-panel" id="filters-panel" hidden>
        <div class="filters-panel__row">
          <div class="filters-panel__field filters-panel__field--search">
            <span class="material-symbols-outlined">search</span>
            <input type="text" id="filter-search" placeholder="Buscar por nombre o matrícula…" autocomplete="off" />
          </div>
          <div class="filters-panel__field">
            <label for="filter-grado">Grado</label>
            <select id="filter-grado">
              <option value="">Todos</option>
            </select>
          </div>
          <div class="filters-panel__field">
            <label for="filter-estado">Estado</label>
            <select id="filter-estado">
              <option value="">Todos</option>
              <option value="Activo">Activo</option>
              <option value="En Prueba">En Prueba</option>
              <option value="Suspendido">Suspendido</option>
            </select>
          </div>
          <button class="btn btn--outline" id="clear-filters-btn" type="button">
            <span class="material-symbols-outlined btn__icon">close</span>
            Limpiar
          </button>
        </div>
        <p class="filters-panel__count" id="filters-count"></p>
      </div>

      <div class="stats-grid">

        <div class="glass-card stat-card">
          <div class="stat-icon primary">
            <span class="material-symbols-outlined">group</span>
          </div>
          <div>
            <p class="stat-label">Total de Estudiantes</p>
            <p class="stat-value" id="stat-total">—</p>
          </div>
        </div>

        <div class="glass-card stat-card">
          <div class="stat-icon secondary">
            <span class="material-symbols-outlined">trending_up</span>
          </div>
          <div>
            <p class="stat-label">Asistencia Promedio</p>
            <p class="stat-value" id="stat-attendance">—</p>
          </div>
        </div>

        <div class="glass-card stat-card">
          <div class="stat-icon tertiary">
            <span class="material-symbols-outlined">school</span>
          </div>
          <div>
            <p class="stat-label">En Lista de Honor</p>
            <p class="stat-value" id="stat-honor">—</p>
          </div>
        </div>

        <div class="glass-card stat-card">
          <div class="stat-icon error">
            <span class="material-symbols-outlined">warning</span>
          </div>
          <div>
            <p class="stat-label">En Riesgo</p>
            <p class="stat-value" id="stat-risk">—</p>
          </div>
        </div>

      </div>

      <div class="glass-card table-wrapper">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Estudiante</th>
                <th>Matrícula</th>
                <th>Grado / Grupo</th>
                <th>Estado</th>
                <th>Asistencia</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody id="students-tbody">
              <tr>
                <td colspan="6" class="students-empty">Cargando estudiantes…</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="pagination">
          <span class="pagination-info" id="pagination-info">Mostrando…</span>
          <div class="pagination-controls" id="pagination-controls"></div>
        </div>
      </div>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <div class="site-footer__brand-col">
            <div class="site-footer__name">Ingreso Seguro</div>
            <p class="site-footer__desc">Plataforma integral de gestión educativa: seguridad, asistencia y administración
              institucional en un solo lugar.</p>
            <div class="site-footer__logos">
              <a class="site-footer__logo-slot" href="https://www.seduca.gov.co/" target="_blank"
                rel="noopener noreferrer" aria-label="Logo institución 1 — ir al sitio de la institución"><img
                  src="logo-institucion-1.jpeg" alt="Logo institución 1" /></a>
              <a class="site-footer__logo-slot" href="https://pascualbravo.edu.co/" target="_blank"
                rel="noopener noreferrer" aria-label="Logo institución 2 — ir al sitio de la institución"><img
                  src="logo-institucion-2.jpeg" alt="Logo institución 2" /></a>
              <a class="site-footer__logo-slot" href="https://www.iesanantoniodeprado.edu.co/" target="_blank"
                rel="noopener noreferrer" aria-label="Logo institución 3 — ir al sitio de la institución"><img
                  src="escudo-sadep.png" alt="Logo institución 3" /></a>
            </div>
          </div>
          <div class="site-footer__cols">
          <div>
            <p class="site-footer__col-title">Nosotros</p>
            <div class="site-footer__col-links">
              <a href="nosotros.html">Quiénes somos</a>
              <a href="nosotros.html">Nuestro equipo</a>
            </div>
          </div>
          <div>
            <p class="site-footer__col-title">Ayuda</p>
            <div class="site-footer__col-links">
              <a href="#">Centro de soporte</a>
              <a href="#">Preguntas frecuentes</a>
              <a href="#">Reportar un problema</a>
            </div>
          </div>
        </div>
          </div>
        <div class="site-footer__bottom">
            <div class="site-footer__copy">© 2026 Ingreso Seguro</div>
          </div>
      </footer>

    </main>

    <!-- Modal: Ver código QR -->
    <div class="modal-overlay" id="qr-view-overlay" hidden>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="qr-view-title">
        <div class="modal-card__header">
          <h3 class="modal-card__title" id="qr-view-title">Código QR del estudiante</h3>
          <button class="modal-card__close" id="qr-view-close" type="button" aria-label="Cerrar">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div class="modal-card__body">
          <div class="qr-view">
            <canvas id="qr-view-canvas" width="220" height="220"></canvas>
            <p class="qr-view__name" id="qr-view-name">—</p>
            <p class="qr-view__meta" id="qr-view-meta">—</p>
          </div>
          <div class="modal-card__actions">
            <button class="btn btn--outline" id="qr-view-download" type="button">
              <span class="material-symbols-outlined btn__icon">download</span>
              Descargar
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal: Editar Estudiante -->
    <div class="modal-overlay" id="edit-student-overlay" hidden>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-student-title">
        <div class="modal-card__header">
          <h3 class="modal-card__title" id="edit-student-title">Editar Estudiante</h3>
          <button class="modal-card__close" id="edit-student-close" type="button" aria-label="Cerrar">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <form class="modal-card__body" id="edit-student-form" novalidate>
          <input type="hidden" id="edit-student-matricula" />

          <div class="field">
            <label for="edit-student-nombre">Nombre completo</label>
            <input id="edit-student-nombre" type="text" required autocomplete="off" />
            <p class="field-error" id="edit-nombre-error" hidden></p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="edit-student-grado">Grado</label>
              <select id="edit-student-grado" required>
                <option value="6">Sexto (6°)</option>
                <option value="7">Séptimo (7°)</option>
                <option value="8">Octavo (8°)</option>
                <option value="9">Noveno (9°)</option>
                <option value="10">Décimo (10°)</option>
                <option value="11">Once (11°)</option>
              </select>
            </div>
            <div class="field">
              <label for="edit-student-grupo">Grupo</label>
              <select id="edit-student-grupo" required>
                <option value="1">Grupo 1</option>
                <option value="2">Grupo 2</option>
                <option value="3">Grupo 3</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="edit-student-estado">Estado</label>
            <select id="edit-student-estado">
              <option value="Activo">Activo</option>
              <option value="En Prueba">En Prueba</option>
              <option value="Suspendido">Suspendido</option>
            </select>
          </div>

          <p class="form-banner" id="edit-student-banner" hidden></p>

          <div class="modal-card__actions">
            <button class="btn btn--outline" type="button" id="edit-student-cancel">Cancelar</button>
            <button class="btn btn--primary" type="submit">
              <span class="material-symbols-outlined btn__icon">save</span>
              Guardar Cambios
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="spa-view" id="view-settings">
    <main class="main-content">
      <div class="settings-inner">

        <div class="settings-page-header">
          <h1 class="text-h1">Perfil</h1>
          <p class="text-body-md">Administra tu perfil.</p>
        </div>

        <div class="bento-grid">

          <div class="section-card col-6">
            <div class="section-card-header">
              <h3 class="text-h3">Información Personal</h3>
            </div>
            <div class="section-card-body">

              <div class="profile-row">
                <div class="avatar-photo">
                  <div class="avatar-photo-overlay">
                    <span class="material-symbols-outlined">photo_camera</span>
                  </div>
                </div>
                <div class="profile-row-text">
                  <p class="profile-name"><%= nombre %></p>
                  <p class="profile-role"><%= rolLabel %></p>
                </div>
              </div>

              <div class="info-grid">
                <div class="field">
                  <label>Nombre Completo</label>
                  <input type="text" value="<%= nombre %>"/>
                </div>
                <div class="field">
                  <label>Correo Electrónico</label>
                  <input type="email" value=""/>
                </div>
                <div class="field span-2">
                  <label>Cargo</label>
                  <div class="field-readonly">
                    <span><%= rolLabel %></span>
                  </div>
                </div>
              </div>

            </div>
            <div class="section-card-footer">
              <button class="btn btn-primary btn-sm">Guardar Cambios</button>
            </div>
          </div>

          <div class="section-card col-6">
            <div class="section-card-header">
              <h3 class="text-h3">Seguridad y Acceso</h3>
            </div>
            <div class="section-card-body">
              <div class="password-fields">
                <div class="field">
                  <label>Contraseña Actual</label>
                  <input type="password" placeholder="••••••••"/>
                </div>

                <div class="field">
                  <label>Nueva Contraseña</label>
                  <input type="password"/>
                </div>

                <div class="field">
                  <label>Confirmar Contraseña</label>
                  <input type="password"/>
                </div>

                <button class="btn btn-surface btn-full">Actualizar Contraseña</button>
              </div>
            </div>
          </div>

          <div class="danger-zone col-12">
            <div>
              <h3>Zona de Riesgo</h3>
              <p>Desactivar tu acceso a la plataforma. Esta acción no se puede deshacer.</p>
            </div>
            <button class="btn btn-danger">Desactivar Cuenta</button>
          </div>

        </div>
      </div>
    </main>
  </div>

  <!-- Los scripts de las tres vistas conviven sin problema: cada uno
       comprueba si su parte del DOM existe y todas están en esta página.
       No se incluyen admin-students.js ni admin-users.js porque este
       panel no tiene la sección de Administrador. -->
  <script src="/jspdf.umd.min.js"></script>
  <script src="/jspdf.plugin.autotable.min.js"></script>
  <script src="/qrious.min.js"></script>
  <script src="/dashboard.js" defer></script>
  <script src="/students.js" defer></script>
  <script src="/theme-toggle.js" defer></script>
</body>

</html>
